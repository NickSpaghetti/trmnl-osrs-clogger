{% if ok %}
<div class="layout layout--col layout--stretch-x gap--auto">
  <!-- Rank + Big Counter -->
  <div class="flex flex--row flex--center-y gap--small w--full">
    <div class="osrs-book-frame--sm rounded--small bg--gray-75 flex flex--center">
      <img class="image image-dither osrs-sprite osrs-book-icon--sm" src="{{ osrs_icons[current_rank.icon] }}" alt="{{ current_rank.name }}">
    </div>
    <div class="flex flex--col">
      <span class="value value--small value--tnums">{{ total_finished }}/{{ total_available }}</span>
      <span class="label label--small">{{ current_rank.label }} ({{ overall_pct }}%)</span>
    </div>
  </div>

  <!-- Rank Progress Bar -->
  <div class="osrs-bar-wrap">
    {% capture q_label %}Next: {{ next_rank.label }}{% endcapture %}
    {% capture q_val %}{{ total_finished }}/{{ bar_target }}{% endcapture %}
    {% render "osrs_progress_bar", bar_class: "progress-bar--small", show_header: true, bar_label: q_label, bar_value: q_val, pct: rank_pct %}
  </div>

  <!-- Latest 6 Drops -->
  <div class="osrs-tray rounded--small bg--gray-75 p--1 w--full flex flex--center-y">
    {% if recent_count > 0 %}
    <div class="grid grid--cols-6 gap--xsmall w--full">
      {% for item in recent_items limit: 6 %}
      <div class="flex flex--center">
        <img class="image image-dither osrs-sprite osrs-drop-icon--sm" src="{{ item.icon_url }}" alt="{{ item.name }}">
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="flex flex--center p--1 w--full">
      <span class="label label--small">No recent drops yet</span>
    </div>
    {% endif %}
  </div>
</div>

{% capture title_text %}{{ player_name }}{% endcapture %}
{% capture instance_text %}{{ game_mode }}{% endcapture %}
{% render "osrs_title_bar", book_icon_url: osrs_icons.collection_log, title_text: title_text, instance_text: instance_text %}
{% else %}
{% render "osrs_error_state", book_icon_url: osrs_icons.collection_log, error: error %}
{% render "osrs_title_bar", book_icon_url: osrs_icons.collection_log, title_text: "Collection Log", instance_text: player_name %}
{% endif %}
