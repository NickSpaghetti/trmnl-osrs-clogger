{% if ok %}
<div class="layout layout--col layout--stretch-x gap--auto">
  <!-- Rank Header -->
  <div class="osrs-no-shrink flex flex--row flex--center-y gap--small w--full">
    <div class="osrs-book-frame--sm rounded--small bg--gray-75 flex flex--center">
      <img class="image image-dither osrs-sprite osrs-book-icon--sm w--[28px] h--[28px] lg:w--[40px] lg:h--[40px]" src="{{ osrs_icons[current_rank.icon] }}" alt="{{ current_rank.name }}">
    </div>
    <div class="osrs-flex-grow osrs-bar-wrap">
      {% capture rank_bar_label %}{{ current_rank.label }} &rarr; {{ next_rank.label }}{% endcapture %}
      {% capture rank_bar_val %}{{ total_finished }}/{{ bar_target }}{% endcapture %}
      {% render "osrs_progress_bar", bar_class: "progress-bar--small", show_header: true, bar_label: rank_bar_label, bar_value: rank_bar_val, pct: rank_pct %}
    </div>
  </div>

  <!-- 5 Categories List -->
  {% for cat in categories %}
  <div class="osrs-no-shrink osrs-card rounded--small bg--gray-75 px--1 flex flex--row flex--center-y gap--small w--full">
    <img class="image image-dither osrs-sprite osrs-cat-icon--sm w--[22px] h--[22px] lg:w--[36px] lg:h--[36px]" src="{{ osrs_icons[cat.icon] }}" alt="{{ cat.name }}">
    <div class="osrs-flex-grow osrs-bar-wrap">
      {% capture cat_val %}{{ cat.obtained }}/{{ cat.total }}{% endcapture %}
      {% render "osrs_progress_bar", bar_class: "progress-bar--xsmall", show_header: true, bar_label: cat.name, bar_value: cat_val, pct: cat.pct %}
    </div>
  </div>
  {% endfor %}

  <!-- Latest Collections (6 items) -->
  <div class="osrs-tray rounded--small bg--gray-75 p--1 w--full flex flex--center-y">
    {% if recent_count > 0 %}
    <div class="osrs-drop-row w--full">
      {% for item in recent_items limit: 6 %}
      <div class="osrs-drop-slot">
        <img class="image image-dither osrs-sprite osrs-drop-icon--sm w--[28px] h--[28px] lg:w--[48px] lg:h--[48px]" src="{{ item.icon_url }}" alt="{{ item.name }}">
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="flex flex--center p--1 w--full">
      <span class="label label--small lg:label--large">No recent drops yet</span>
    </div>
    {% endif %}
  </div>
</div>

{% capture title_text %}{{ player_name }}{% endcapture %}
{% capture instance_text %}{{ total_finished }}/{{ total_available }}{% endcapture %}
{% render "osrs_title_bar", book_icon_url: osrs_icons.collection_log, title_text: title_text, instance_text: instance_text %}
{% else %}
{% render "osrs_error_state", book_icon_url: osrs_icons.collection_log, error: error %}
{% render "osrs_title_bar", book_icon_url: osrs_icons.collection_log, title_text: "Collection Log", instance_text: player_name %}
{% endif %}
